# Non-secret configuration used by the Lambda handler.
# Copy this file to .env for local runs if you want to override defaults.
# The real Lambda function reads PRICING_CONFIG from its own environment
# variables, not from this file.

PRICING_CONFIG={"currency":"INR","maxNights":30,"taxRatePercent":0,"rooms":{"classic":{"displayName":"Classic","pricePerNight":2000},"deluxe":{"displayName":"Deluxe","pricePerNight":3000},"duplex":{"displayName":"Duplex","pricePerNight":5000},"suite":{"displayName":"Suite","pricePerNight":7000}}}
